stateDiagram-v2
    direction LR
    state "Necesidad" as NEC {
        [*] --> pendiente
        pendiente --> asignada: assign_resource cubre la cantidad
        pendiente --> cancelada
        asignada --> en_atencion
        asignada --> cancelada
        en_atencion --> atendida
        atendida --> [*]
        cancelada --> [*]
    }
    state "Persona" as PER {
        [*] --> sin_informacion
        sin_informacion --> reportada
        sin_informacion --> localizada
        reportada --> localizada
        reportada --> trasladada
        reportada --> en_albergue
        localizada --> trasladada
        localizada --> en_albergue
        localizada --> reunificada
        trasladada --> en_albergue
        trasladada --> reunificada
        en_albergue --> trasladada
        en_albergue --> reunificada
        reunificada --> [*]
    }
    state "Mascota" as MAS {
        [*] --> activa
        activa --> posible_coincidencia: match_pets (puntaje ≥ 50)
        posible_coincidencia --> activa: se descarta
        posible_coincidencia --> resuelta: confirm_pet_match
        activa --> resuelta: confirm_pet_match
        resuelta --> [*]
    }
